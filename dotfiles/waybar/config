{
    "layer": "bottom",
    "position": "top",
    "height": 30,
    "spacing": 0,

    "modules-left": [
        "sway/mode",
        "sway/workspaces",
	"custom/padding",
        "mpd"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "tray",
	"network",
	"pulseaudio",
        "temperature",
        "battery"
    ],

    "sway/workspaces": {
        "disable-scroll": true,
        "format": "{name}"
    },
    "sway/mode": {
        "format": "{}"
    },
    "custom/padding": {
	"format": " "
    },
    "mpd": {
	"format": "{artist} - {title}",
    "format-stopped": "",
	"tooltip": false,
	"on-click": "mpc toggle"
    },

    "clock": {
        "format": "{:%A %I:%M%p %b %d}",
        "interval": 5,
        "tooltip-format": "<span>{calendar}</span>",
	"calendar": {
            "mode": "year",
	    "mode-mon-col": 3,
            "weeks-pos": "right",
            "format": {
        	"months": "<span color='#f5c2e7'><b>{}</b></span>",
        	"weekdays": "<span color='#89b4fa'><b>{}</b></span>",
        	"today": "<span color='#f38ba8'><b><u>{}</u></b></span>"
            }
    	}
    },

    "tray": {
        "icon-size": 16,
        "spacing": 5,
        "tooltip": false
    },
    "network": {
        "format-ethernet": "{ipaddr}/{cidr}",
        "format-wifi": "{essid} {icon}",
        "format-disconnected": "No connection",
	"format-icons": [
	    "󰤟",
	    "󰤢",
	    "󰤥",
	    "󰤨"
	],
        "tooltip": false,
        "interval": 5
    },
    "pulseaudio": {
	"format": "{volume}% {icon}",
	"format-muted": "{volume}% 󰝟",
	"format-icons": {
	    "headphone": "",
	    "headset": "",
	    "phone": "",
	    "portable": "",
	    "car": "",
	    "default": ["", ""]
        },
	"on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
	"tooltip": false
    },
    "temperature": {
        "critical-threshold": 80,
        "hwmon-path": "/sys/class/hwmon/hwmon2/temp2_input",
        "format": "{temperatureC}°C",
        "tooltip": false
    },
    "battery": {
	"interval": 20,
	"states": {
	    "warning": 30,
	    "critical": 20
	},
	"events": {
            "on-discharging-warning": "notify-send -u normal 'Low Battery'",
            "on-discharging-critical": "notify-send -u critical 'Very Low Battery'"
        },

        "format": "{capacity}% ",
        "format-full": "{capacity}% ",
        "format-charging": "{capacity}% ",
        "format-charging-full": "{capacity}% ",
        "tooltip": false,
        "interval": 30
    }
}
